    },
    {
      "id": "4.2.8",
      "name": "AM包络",
      "expression": "|s_L(t)|=A_c+A'm(t)=A_c[1+am_n(t)]",
      "conditions": ""
    },
    {
      "id": "4.2.9",
      "name": "调幅系数",
      "expression": "a=A'|m(t)|_{max}/A_c ≤ 1",
      "conditions": ""
    },
    {
      "id": "4.2.12",
      "name": "AM已调信号",
      "expression": "s(t)=A_c[1+am_n(t)]cos(2πf_c t)",
      "conditions": ""
    },
    {
      "id": "4.2.15",
      "name": "AM调制效率",
      "expression": "η=(A'²P_m)/(A_c²+A'²P_m)=a²P_{mn}/(1+a²P_{mn})",
      "conditions": ""
    },
    {
      "id": "4.2.16",
      "name": "基带信号峰均比",
      "expression": "C_m=|m(t)|²_{max}/m²(t)=1/P_{mn}",
      "conditions": ""
    },
    {
      "id": "4.2.17",
      "name": "调制效率与调幅系数、峰均比的关系",
      "expression": "η=1/(1+C_m/a²)",
      "conditions": ""
    },
    {
      "id": "4.2.20",
      "name": "上边带SSB信号",
      "expression": "s_{USB}(t)=(A_c/2)[m(t)cos(2πf_c t)-\\hat{m}(t)sin(2πf_c t)]",
