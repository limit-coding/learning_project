    },
    {
      "id": "4.2.3",
      "name": "DSB-SC频谱",
      "expression": "S(f)=(A_c/2)[M(f-f_c)+M(f+f_c)]",
      "conditions": ""
    },
    {
      "id": "4.2.5",
      "name": "DSB-SC相干解调输出",
      "expression": "y_o(t)=A_c m(t)",
