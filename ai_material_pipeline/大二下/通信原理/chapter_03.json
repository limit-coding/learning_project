      "id": "3.2.54",
      "name": "互维纳-辛钦定理",
      "expression": "P_{XY}(f) = ℱ{R̄_{XY}(τ)}",
      "context": "互PSD与平均互相关"
    },
    {
      "id": "3.2.57",
      "name": "周期冲激序列平均自相关",
      "expression": "R̄_X(τ) = (1/T_s)·δ(τ)",
      "context": "例3.2.8"
    },
    {
      "id": "3.2.58",
      "name": "周期冲激序列功率谱密度",
      "expression": "P_X(f) = 1/T_s",
      "context": "例3.2.8"
    },
    {
      "id": "3.2.59",
      "name": "随机过程通过滤波器（时域）",
      "expression": "Y(e,t) = ∫_{-∞}^{+∞} h(t-τ)X(e,τ) dτ",
      "context": "卷积关系"
    },
    {
      "id": "3.2.60",
      "name": "输出均值",
      "expression": "m_Y(t) = ∫_{-∞}^{+∞} h(t-τ)m_X(τ) dτ",
      "context": "均值通过滤波器"
    },
    {
      "id": "3.2.62",
      "name": "输出功率谱密度",
      "expression": "P_Y(f) = |H(f)|²·P_X(f)",
      "context": "输入输出PSD关系"
    },
    {
      "id": "3.2.63",
      "name": "互功率谱密度",
      "expression": "P_{XY}(f) = H*(f)·P_X(f), P_{YX}(f) = H(f)·P_X(f)",
      "context": "输入输出互PSD"
    },
    {
      "id": "3.2.64",
      "name": "输出相关函数（时域）",
      "expression": "R̄_Y(τ) = R̄_X(τ) * h(τ) * h*(-τ), R̄_{XY}(τ) = R̄_X(τ) * h*(-τ), R̄_{YX}(τ) = R̄_X(τ) * h(τ)",
      "context": "时域卷积关系"
    },
    {
      "id": "3.3.1",
      "name": "严平稳定义",
      "expression": "p_X(x1,...,xn,t1,...,tn) = p_X(x1,...,xn,t1+Δ,...,tn+Δ)",
      "context": "任意维联合分布时移不变"
    },
    {
      "id": "3.3.12",
      "name": "平稳过程通过滤波器输出均值",
      "expression": "m_Y = m_X·H(0)",
      "context": "直流增益"
    },
    {
      "id": "3.3.15",
      "name": "希尔伯特变换互相关",
      "expression": "R_{ŶX}(τ) = R̂_X(τ)（希尔伯特变换）",
      "context": "例3.3.5"
    },
    {
      "id": "3.4.1",
      "name": "复随机变量期望",
      "expression": "E[Z] = E[X] + j·E[Y]",
      "context": "实部虚部分别期望"
    },
    {
      "id": "3.4.3",
      "name": "复随机变量内积",
      "expression": "⟨Z1,Z2⟩ = E[Z1·Z2*]",
      "context": "共轭乘积期望"
    },
    {
      "id": "3.4.4",
      "name": "复许瓦兹不等式",
      "expression": "|E[Z1·Z2*]| ≤ √(E[|Z1|²]·E[|Z2|²])",
      "context": "复随机变量"
    },
    {
      "id": "3.4.6",
      "name": "复随机变量方差",
      "expression": "σ_Z² = E[|Z-E[Z]|²] = E[|Z|²] - |E[Z]|²",
      "context": "平均功率减去均值模平方"
    },
    {
      "id": "3.4.8",
      "name": "复随机过程自相关函数",
      "expression": "R_Z(t1,t2) = E[Z(t1)·Z*(t2)]",
      "context": "含共轭"
    },
    {
      "id": "3.4.10",
      "name": "共轭相关函数",
      "expression": "R_{ZZ*}(t1,t2) = E[Z(t1)·Z(t2)]",
      "context": "复随机过程特有"
    },
    {
      "id": "3.4.18",
      "name": "复平稳自相关共轭对称",
      "expression": "R_Z(τ) = R_Z*(-τ)",
      "context": "复平稳过程性质"
    },
    {
      "id": "3.4.24",
      "name": "解析信号自相关",
      "expression": "R_z(τ) = 2[R_x(τ) + j·R̂_x(τ)]",
      "context": "带通随机信号"
    },
    {
      "id": "3.4.25",
      "name": "解析信号共轭相关",
      "expression": "R_{zz*}(τ) = 0",
      "context": "带通随机信号"
    },
    {
      "id": "3.4.27",
      "name": "复包络自相关",
      "expression": "R_{xL}(τ) = R_z(τ)·e^{-j2πf_cτ} = 2[R_x(τ)+j·R̂_x(τ)]·e^{-j2πf_cτ}",
      "context": "带通随机信号"
    },
    {
      "id": "3.4.30",
      "name": "同相/正交分量自相关",
      "expression": "R_{x_c}(τ) = R_{x_s}(τ) = (1/2)·Re{R_{xL}(τ)}",
      "context": "带通信号基带分量"
    },
    {
      "id": "3.4.31",
      "name": "同相正交互相关",
      "expression": "R_{x_c x_s}(τ) = -(1/2)·Im{R_{xL}(τ)}",
      "context": "带通信号基带分量"
    },
    {
      "id": "3.5.1",
      "name": "一维高斯分布PDF",
      "expression": "p_X(x) = (1/√(2πσ²))·exp[-(x-m)²/(2σ²)]",
      "context": "N(m,σ²)"
    },
    {
      "id": "3.5.3",
      "name": "Q函数",
      "expression": "Q(x) = P(X>x) = ∫_x^{+∞} (1/√(2π))·exp(-u²/2) du, X~N(0,1)",
      "context": "标准正态右尾概率"
    },
    {
      "id": "3.5.4",
      "name": "erfc函数",
      "expression": "erfc(x) = P(|X|>x) = 2∫_x^{+∞} (1/√π)·exp(-u²) du, X~N(0,1/2)",
      "context": "双尾概率"
    },
    {
      "id": "3.5.5",
      "name": "Q函数与erfc关系",
      "expression": "Q(x) = (1/2)·erfc(x/√2)",
      "context": "换算"
    },
    {
      "id": "3.5.6",
      "name": "联合高斯线性变换",
      "expression": "X = AZ + m",
      "context": "独立标准正态线性变换"
    },
    {
      "id": "3.5.8",
      "name": "AWGN功率谱密度",
      "expression": "P_{nw}(f) = N0/2, -∞<f<∞",
      "context": "双边谱"
    },
    {
      "id": "3.5.9",
      "name": "AWGN自相关函数",
      "expression": "R_{nw}(τ) = (N0/2)·δ(τ)",
      "context": "白噪声"
    },
    {
      "id": "3.5.12",
      "name": "限带白噪声自相关",
      "expression": "R_B(τ) = N0·B·sinc(2Bτ)",
      "context": "带宽B的理想低通"
    },
    {
      "id": "3.5.13",
      "name": "限带白噪声相关系数",
      "expression": "ρ = sinc(2Bτ)",
      "context": ""
    },
    {
      "id": "3.5.15",
      "name": "AWGN通过滤波器输出功率谱密度",
      "expression": "P_n(f) = (N0/2)·|H(f)|²",
      "context": ""
    },
    {
      "id": "3.5.16",
      "name": "输出噪声功率（能量形式）",
      "expression": "E[n²(t)] = (N0/2)·E_h",
      "context": "E_h为滤波器能量"
    },
    {
      "id": "3.5.17",
      "name": "理想低通输出噪声功率",
      "expression": "E[n²(t)] = N0·B",
      "context": "带宽B、增益1"
    },
    {
      "id": "3.5.21",
      "name": "AWGN信道模型",
      "expression": "r(t) = s(t) + n_w(t)",
      "context": "加性噪声"
    },
    {
      "id": "3.5.22",
      "name": "热噪声功率谱密度",
      "expression": "N0 = kT",
      "context": "玻尔兹曼常数k，绝对温度T"
    },
    {
      "id": "3.5.25",
      "name": "窄带噪声功率谱密度",
      "expression": "P_n(f) = (N0/2)·|H(f)|²",
      "context": "带通滤波器"
    },
    {
      "id": "3.5.26",
      "name": "窄带噪声复包络功率谱密度",
      "expression": "P_{nL}(f) = 4·P_n(f+f_c), |f|≤f_c; 0 其他",
      "context": "带通→基带"
    },
    {
      "id": "3.5.27",
      "name": "同相/正交分量功率谱密度",
      "expression": "P_{nc}(f) = P_{ns}(f) = P_n(f-f_c) + P_n(f+f_c), |f|≤f_c; 0 其他",
      "context": ""
    },
    {
      "id": "3.6.4",
      "name": "采样时刻信噪比",
      "expression": "γ = s0² / E[Z²]",
      "context": "滤波器输出"
    },
    {
      "id": "3.6.6",
      "name": "匹配滤波器冲激响应",
      "expression": "h(t) = K·s(t0 - t)",
      "context": "K为非零系数"
    },
    {
      "id": "3.6.7",
      "name": "匹配滤波器最大信噪比",
      "expression": "γ_max = 2E / N0",
      "context": "E为信号能量"
    },
    {
      "id": "3.6.8",
      "name": "匹配滤波器传递函数",
      "expression": "H(f) = K·S*(f)·e^{-j2πft0}",
      "context": "频域"
    },
    {
      "id": "3.6.9",
      "name": "相关器输出",
      "expression": "y(t0) = ∫_{-∞}^{+∞} r(τ)·s(τ) dτ",
      "context": "t0=0时"
    },
    {
      "id": "3.6.10",
      "name": "复信号匹配滤波器冲激响应",
      "expression": "h(t) = K·s*(t0 - t)",
      "context": "复信号"
    }
  ],
