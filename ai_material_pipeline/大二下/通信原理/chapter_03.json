  "keyPoints": [
    "随机过程可视为样本函数族或沿时间轴排列的随机变量族",
    "给定样本e，随机过程退化为确定信号；给定时刻t，退化为随机变量",
    "统计平均按e操作消去随机性，时间平均按t操作消去时变性",
    "随机过程的平均功率等于瞬时功率同时进行统计平均和时间平均，且两种平均可交换次序",
    "独立一定不相关；在联合高斯条件下，不相关等价于独立",
    "零均值时，正交与不相关等价",
    "自相关函数是偶函数，在τ=0处取最大值，该最大值等于平均功率",
    "维纳-辛钦定理：功率谱密度等于平均自相关函数的傅氏变换",
    "严平稳要求任意维联合分布对时移不变；宽平稳只要求均值常数、自相关仅与时差有关",
    "遍历性意味着任一样本函数的时间平均以概率1等于随机过程的统计平均",
    "复平稳过程除均值和自相关函数外，还要求共轭相关函数与绝对时间无关",
    "平稳带通信号的同相分量与正交分量在同一时刻不相关，且三者功率相同",
    "圆对称复高斯的实部与虚部独立同分布，幅度服从瑞利分布，模平方服从指数分布",
    "AWGN的双边功率谱密度为N0/2，单边功率谱密度为N0；均值为零",
    "限带白高斯噪声是物理可实现的近似，样本函数以概率1处处连续",
    "窄带高斯噪声的包络服从瑞利分布，相位服从均匀分布，包络与相位独立",
    "匹配滤波器输出最大信噪比为2E/N0，冲激响应为发送信号的时间反转延迟",
    "匹配滤波器在最佳采样点的输出等价于接收信号与发送信号的内积（相关）",
    "热噪声功率谱密度N0=kT，室温下约为-174 dBm/Hz"
  ],
  "formulas": [
    {
      "id": "3.2.1",
      "name": "事件概率大数定律",
      "expression": "P(A) = lim_{N→∞} N_A / N",
      "context": "概率测量基本原理"
    },
    {
      "id": "3.2.2",
      "name": "联合概率链式法则",
      "expression": "P(A,B) = P(A)P(B|A) = P(B)P(A|B)",
      "context": "条件概率与联合概率"
    },
    {
      "id": "3.2.3",
      "name": "贝叶斯公式",
      "expression": "P(A|B) = P(B|A)P(A) / P(B)",
      "context": "后验概率计算"
    },
    {
      "id": "3.2.4",
      "name": "伯努利分布PDF",
      "expression": "p_X(x) = p·δ(x-1) + (1-p)·δ(x)",
      "context": "离散随机变量概率密度"
    },
    {
      "id": "3.2.7",
      "name": "联合概率密度链式法则",
      "expression": "p_{X,Y}(x,y) = p_X(x)·p_{Y|X}(y|x) = p_Y(y)·p_{X|Y}(x|y)",
      "context": "二维随机变量"
    },
    {
      "id": "3.2.10",
      "name": "随机过程一维PDF示例",
      "expression": "p_X(x,t) = (3/4)δ[x-cos(2πf_b t)] + (1/4)δ[x+cos(2πf_b t)]",
      "context": "示例3.2.3"
    },
    {
      "id": "3.2.16",
      "name": "离散随机变量数学期望",
      "expression": "E[X] = Σ a_i p_i",
      "context": "统计平均"
    },
    {
      "id": "3.2.17",
      "name": "连续随机变量数学期望",
      "expression": "E[X] = ∫_{-∞}^{+∞} x·p_X(x) dx",
      "context": "统计平均"
    },
    {
      "id": "3.2.18",
      "name": "随机变量分解",
      "expression": "X = X̄ + m_X",
      "context": "零均值分解"
    },
    {
      "id": "3.2.19",
      "name": "大数定律测量期望",
      "expression": "E[X] = lim_{N→∞} (1/N) Σ_{i=1}^{N} x_i",
      "context": "工程测量"
    },
    {
      "id": "3.2.20",
      "name": "随机变量函数的期望",
      "expression": "E[Y] = ∫ g(x)·p_X(x) dx",
      "context": "Y=g(X)"
    },
    {
      "id": "3.2.21",
      "name": "期望线性性质",
      "expression": "E[aX + c] = aE[X] + c",
      "context": "线性变换"
    },
    {
      "id": "3.2.22",
      "name": "方差定义",
      "expression": "σ_X² = E[(X-m_X)²] = E[X²] - m_X²",
      "context": "二阶中心矩"
    },
    {
      "id": "3.2.23",
      "name": "随机过程均值",
      "expression": "m_X(t) = E[X(e,t)] = ∫ x·p_X(x,t) dx",
      "context": "一阶统计量"
    },
    {
      "id": "3.2.24",
      "name": "随机过程零均值分解",
      "expression": "X(e,t) = X̄(e,t) + m_X(t)",
      "context": "平稳/非平稳过程"
    },
    {
      "id": "3.2.25",
      "name": "时间平均",
      "expression": "⟨X(e,t)⟩ = lim_{T→∞} (1/T) ∫_{-T/2}^{T/2} X(e,t) dt",
      "context": "对t操作"
    },
    {
      "id": "3.2.28",
      "name": "平均功率",
      "expression": "P_X = E[⟨X²(e,t)⟩] = ⟨E[X²(e,t)]⟩",
      "context": "时间平均与统计平均可交换"
    },
    {
      "id": "3.2.29",
      "name": "随机过程方差",
      "expression": "σ_X²(t) = E[(X(e,t)-m_X(t))²] = E[X²(e,t)] - m_X²(t)",
      "context": "瞬时方差"
    },
    {
      "id": "3.2.30",
      "name": "随机过程功率分解",
      "expression": "P_X = ⟨σ_X²(t)⟩ + ⟨m_X²(t)⟩",
      "context": "零均值分量功率+均值功率"
    },
    {
      "id": "3.2.31",
      "name": "随机变量内积",
      "expression": "⟨X,Y⟩ = E[XY]",
      "context": "相关运算"
    },
    {
      "id": "3.2.32",
      "name": "协方差",
      "expression": "Cov(X,Y) = E[(X-m_X)(Y-m_Y)]",
      "context": "扣除均值后的内积"
    },
    {
      "id": "3.2.33",
      "name": "方差",
      "expression": "σ_X² = E[(X-m_X)²]",
      "context": "X=Y时的协方差"
    },
    {
      "id": "3.2.34",
      "name": "和的功率",
      "expression": "E[(X+Y)²] = E[X²] + E[Y²] + 2E[XY]",
      "context": "互功率项"
    },
    {
      "id": "3.2.35",
      "name": "许瓦兹不等式",
      "expression": "|E[XY]| ≤ √(E[X²]·E[Y²])",
      "context": "内积性质"
    },
    {
      "id": "3.2.36",
      "name": "相关系数",
      "expression": "ρ = Cov(X,Y) / (σ_X·σ_Y)",
      "context": "标准化后的内积"
    },
    {
      "id": "3.2.37",
      "name": "不相关条件",
      "expression": "E[XY] = E[X]E[Y]",
      "context": "零均值协方差"
    },
    {
      "id": "3.2.39",
      "name": "自相关函数",
      "expression": "R_X(t1,t2) = E[X(t1)X(t2)]",
      "context": "随机过程"
    },
    {
      "id": "3.2.40",
      "name": "互相关函数",
      "expression": "R_{XY}(t1,t2) = E[X(t1)Y(t2)]",
      "context": "两个随机过程"
    },
    {
      "id": "3.2.41",
      "name": "互相关函数次序调换",
      "expression": "R_{YX}(t1,t2) = R_{XY}(t2,t1)",
      "context": "对称性质"
    },
    {
      "id": "3.2.42",
      "name": "不相关过程之和的自相关",
      "expression": "R_{X+Y}(t1,t2) = R_X(t1,t2) + R_Y(t1,t2)",
      "context": "零均值不相关"
    },
    {
      "id": "3.2.43",
      "name": "零均值过程叠加确定信号的自相关",
      "expression": "R_{X+m}(t1,t2) = R_X(t1,t2) + m(t1)m(t2)",
      "context": "均值非零"
    },
    {
      "id": "3.2.44",
      "name": "样本自相关函数",
      "expression": "R̂_X(e,τ) = ⟨X(e,t+τ)X(e,t)⟩",
      "context": "对t取平均"
    },
