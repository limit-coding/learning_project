    {
      "formulaId": "5.4.17",
      "description": "奈奎斯特准则（频域充要条件）",
      "latex": "\\sum_{m=-\\infty}^{\\infty} X\\left(f + \\frac{m}{T_s}\\right) = T_s",
      "context": "无码间干扰基带传输的频域条件"
    },
    {
      "formulaId": "5.4.24",
      "description": "理想低通冲激响应",
      "latex": "x(t) = \\text{sinc}(2Wt)",
      "context": "奈奎斯特速率下的理想低通响应"
    },
    {
      "formulaId": "5.4.25",
      "description": "升余弦滚降传递函数",
      "latex": "X(f) = \\begin{cases} T_s & |f| \\leq \\frac{1-\\alpha}{2T_s} \\\\ \\frac{T_s}{2}\\left[1 + \\cos\\frac{\\pi T_s}{\\alpha}\\left(|f| - \\frac{1-\\alpha}{2T_s}\\right)\\right] & \\frac{1-\\alpha}{2T_s} < |f| \\leq \\frac{1+\\alpha}{2T_s} \\\\ 0 & |f| > \\frac{1+\\alpha}{2T_s} \\end{cases}",
      "context": "升余弦滤波器频率响应，α为滚降因子"
    },
