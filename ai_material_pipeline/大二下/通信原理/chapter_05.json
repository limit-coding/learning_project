    {
      "formulaId": "5.3.1",
      "description": "AWGN信道接收信号",
      "latex": "r(t) = s_i(t) + n_w(t), \\quad i=1 \\text{ 或 } 2, \\quad 0 \\leq t \\leq T_b",
