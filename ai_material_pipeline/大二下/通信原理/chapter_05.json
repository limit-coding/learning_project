      "formulaId": "5.4.26",
      "description": "升余弦滚降冲激响应",
      "latex": "x(t) = \\text{sinc}\\left(\\frac{t}{T_s}\\right) \\cdot \\frac{\\cos\\left(\\frac{\\pi\\alpha t}{T_s}\\right)}{1 - \\left(\\frac{2\\alpha t}{T_s}\\right)^2}",
      "context": "升余弦滚降系统的总体冲激响应"
    },
    {
      "formulaId": "5.5.7",
