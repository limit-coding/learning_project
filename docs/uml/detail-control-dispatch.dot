digraph ControlDispatch {
  graph [rankdir=TB, bgcolor="white", fontname="Arial", nodesep=0.4, ranksep=0.55];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#64748b", fillcolor="#f8fafc"];
  edge [fontname="Arial", fontsize=10, color="#475569", arrowsize=0.8];

  subgraph cluster_ui {
    label="前端 UI 事件";
    color="#93c5fd";
    fillcolor="#eff6ff";
    style="rounded,filled";
    profile_submit [label="提交学习画像\nProfileForm.onSuccess"];
    roadmap_click [label="点击生成路线图\nButton.onClick"];
    node_select [label="选择路线图节点\nRoadmapCanvas.onSelect"];
    rag_ask [label="提交站内问答\nButton.onClick"];
  }

  subgraph cluster_app {
    label="App.tsx 调度函数";
    color="#a7f3d0";
    fillcolor="#ecfdf5";
    style="rounded,filled";
    handle_profile [label="handleProfileSuccess(id)"];
    handle_roadmap [label="handleGenerateRoadmap()"];
    detail_effect [label="useEffect 加载节点详情"];
    handle_chat [label="handleAskQuestion()"];
  }

  subgraph cluster_api {
    label="前端 API 封装";
    color="#fde68a";
    fillcolor="#fffbeb";
    style="rounded,filled";
    api_rec [label="getRecommendations(id, 5)"];
    api_roadmap [label="generateRoadmap(goal)"];
    api_detail [label="getCourseNodeDetail(nodeId)"];
    api_chat [label="chatRetrieve(question)"];
  }

  subgraph cluster_backend {
    label="FastAPI 路由与服务";
    color="#fecaca";
    fillcolor="#fff1f2";
    style="rounded,filled";
    route_rec [label="GET /api/recommendations/{id}\nget_recommendations()"];
    route_roadmap [label="POST /api/roadmaps/generate\ngenerate_roadmap()"];
    route_detail [label="GET /api/course-nodes/{id}\nget_course_node_detail()"];
    route_chat [label="POST /api/chat/retrieve\nchat_retrieve()"];
    rec_engine [label="RecommendationEngine"];
    llm_service [label="LLMService"];
    rag_service [label="RAGService"];
  }

  subgraph cluster_data {
    label="数据与返回结果";
    color="#c4b5fd";
    fillcolor="#f5f3ff";
    style="rounded,filled";
    db [label="SQLite 数据库\nprofiles / courses / roadmaps / resources"];
    ui_update [label="更新前端状态\nrecommendations / roadmap / detail / chatResult"];
  }

  profile_submit -> handle_profile -> api_rec -> route_rec -> rec_engine -> llm_service -> db -> ui_update;
  roadmap_click -> handle_roadmap -> api_roadmap -> route_roadmap -> llm_service -> db -> ui_update;
  node_select -> detail_effect -> api_detail -> route_detail -> db -> ui_update;
  rag_ask -> handle_chat -> api_chat -> route_chat -> rag_service -> llm_service -> ui_update;
}
