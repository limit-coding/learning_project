digraph RecommendationCall {
  graph [rankdir=TB, bgcolor="white", fontname="Arial", nodesep=0.45, ranksep=0.55];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#64748b", fillcolor="#f8fafc"];
  edge [fontname="Arial", fontsize=10, color="#475569", arrowsize=0.8];

  start [label="用户提交学习画像", shape=oval, fillcolor="#ecfeff", color="#67e8f9"];
  create_profile [label="POST /api/profiles\ncreate_user_profile()"];
  profile_db [label="写入 user_profiles 表"];
  app_success [label="ProfileForm.onSuccess(id)\nApp.handleProfileSuccess(id)"];
  api_call [label="getRecommendations(id, 5)"];
  route [label="GET /api/recommendations/{profile_id}\nget_recommendations()"];
  load_data [label="查询 UserProfile 与 Course 列表"];
  cache_check [label="检查已有 recommendations\nrefresh=false 时可复用", shape=diamond, fillcolor="#fffbeb", color="#f59e0b"];
  top_courses [label="RecommendationEngine.get_top_courses()"];
  match_score [label="calculate_match_score(profile, course)"];
  lang [label="calculate_language_score()\n语言匹配 30 分"];
  diff [label="calculate_difficulty_score()\n难度适配 25 分"];
  domain [label="calculate_domain_score()\n主题相关 25 分"];
  pre [label="calculate_prerequisite_score()\n前置满足 20 分"];
  total [label="total = 四项评分相加\n按分数降序排序取 Top N"];
  llm [label="LLMService.batch_generate_reasons()\n批量生成推荐理由"];
  save [label="写入 recommendations 表"];
  response [label="返回 RecommendationResponse[]\n前端展示课程卡片", shape=oval, fillcolor="#ecfdf5", color="#34d399"];

  start -> create_profile -> profile_db -> app_success -> api_call -> route -> load_data -> cache_check;
  cache_check -> response [label="已有记录"];
  cache_check -> top_courses [label="需要重新计算"];
  top_courses -> match_score;
  match_score -> lang -> total;
  match_score -> diff -> total;
  match_score -> domain -> total;
  match_score -> pre -> total;
  total -> llm -> save -> response;
}
